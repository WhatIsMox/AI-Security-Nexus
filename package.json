{
  "name": "owasp-ai-security-bible",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-all-tests.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:functional": "node --test tests/functional/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:data": "node scripts/validate-data-integrity.mjs",
    "docs:sync": "node scripts/sync-agent-docs.mjs",
    "docs:check": "node scripts/sync-agent-docs.mjs --check"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "sass": "^1.102.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^6.4.2"
  }
}
